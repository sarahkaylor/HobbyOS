check(decide(h, h[:7])[0], "graded 7-char prefix of head -> ALLOW")
check(not decide(h, "fffffff")[0], "graded 7-char non-prefix -> REFUSE")
check(not decide(h, h[:6])[0], "graded prefix <7 chars -> REFUSE")
