+   return-address pushes; comparing these against what the fatal print reads
+   proves or falsifies it for the frame that actually died. */
+static volatile uint64_t gb123_entry_vector[MAX_CPUS];
+static volatile uint64_t gb123_entry_cs[MAX_CPUS];
+static volatile uint64_t gb123_entry_ss[MAX_CPUS];
