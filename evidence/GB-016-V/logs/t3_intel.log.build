mmd -i disk.img ::/EFI/BOOT
mmd -i disk.img ::/boot
mmd -i disk.img ::/home
mmd -i disk.img ::/nfs
mmd -i disk.img ::/mnt
mmd -i disk.img ::/TESTDIR
mmd -i disk.img ::/tmp
