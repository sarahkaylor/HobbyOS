diff --git a/src/kernel/vm.c b/src/kernel/vm.c
index f953398..9828f42 100644
--- a/src/kernel/vm.c
+++ b/src/kernel/vm.c
@@ -22,6 +22,41 @@
 #include "process.h"
 
 extern void uart_puts(const char *s);
+
+/* GB-133: one line whenever a region operation could take the resume page
+   away.  Bracket by measurement -- the page-watch proved the commit sticks
+   (post=1 68/68) and the page is absent again at the next resume, so some
+   region op between two resumes covers 0x17FFFFF000.  These markers say
+   which op, and the seq number says when. */
+static int gb133_seq;
+static void gb133_mark(const char *what, uint64_t base, uint64_t len) {
+  const uint64_t page = 0x17FFFFF000ULL;
+  if (base > page || base + len <= page)
+    return;
+  extern void uart_puts(const char *s);
+  char b[72];
+  int n = 0;
+  const char *p = "[GB133] op=";
+  while (*p && n < 20) b[n++] = *p++;
+  while (*what && n < 32) b[n++] = *what++;
+  const char *p2 = " seq=";
+  while (*p2 && n < 40) b[n++] = *p2++;
+  char t[12];
+  int ti = 0;
+  int v = gb133_seq++;
+  if (v == 0) t[ti++] = '0';
+  while (v > 0 && ti < 11) { t[ti++] = (char)('0' + (v % 10)); v /= 10; }
+  while (ti > 0 && n < 50) b[n++] = t[--ti];
+  const char *p3 = " base=0x";
+  while (*p3 && n < 60) b[n++] = *p3++;
+  static const char hx[] = "0123456789ABCDEF";
+  for (int sh = 60; sh >= 0 && n < 78; sh -= 4)
+    b[n++] = hx[(base >> sh) & 0xF];
+  const char *p4 = "\n";
+  while (*p4 && n < 90) b[n++] = *p4++;
+  b[n] = 0;
+  uart_puts(b);
+}
