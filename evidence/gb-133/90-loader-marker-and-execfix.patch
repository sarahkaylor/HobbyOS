+/* GB-133 bracket: print the leaf state of the resume copy's destination page at
+ * EVERY resume, so a 1->0 transition has a line on each side.  Companion to the
+ * [GB133] op= markers on the region-removal path in vm.c: whichever op line
+ * falls between a pte=1 and the next pte=0 for the same pid is the writer. */
+static void gb133_resume_probe(const char *site, struct process *p,
+                               uint64_t target_sp, uint64_t cs) {
+  extern int vm_arch_walk(struct addr_space *as, uint64_t va, uint64_t *l);
+  if (!p || !p->as)
+    return;
+  int usr = ((cs & 3u) == 3u);
+  uint64_t d = (usr ? target_sp : arch_get_user_sp()) - 320;
+  uint64_t pg = d & ~0xFFFULL;
+  if (pg < USER_MAIN_STK_LIMIT_V2 || pg >= USER_MAIN_STK_TOP_V2)
+    return;
+  uint64_t lf = 0;
+  int pr = (vm_arch_walk(p->as, pg, &lf) == 0);
+  struct kline kb;
+  kl_init(&kb);
+  kl_s(&kb, "[GB133-R] ");
+  kl_s(&kb, site);
+  kl_s(&kb, " pid=");
+  kl_i(&kb, p->pid);
+  kl_s(&kb, " pg=");
+  kl_hex(&kb, pg);
+  kl_s(&kb, " pte=");
+  kl_c(&kb, pr ? '1' : '0');
+  kl_s(&kb, " root=");
+  kl_hex(&kb, p->as->root_phys);
+  kl_s(&kb, " cr3=");
+  {
+    uint64_t cr3v;
+    __asm__ volatile("mov %%cr3, %0" : "=r"(cr3v));
+    kl_hex(&kb, cr3v & 0x000FFFFFFFFFF000ULL);
+  }
+  kl_s(&kb, "\n");
+  kl_emit(&kb);
+}
