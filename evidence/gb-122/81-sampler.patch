+/* GB-122 population sampler: every site that builds a resume frame onto a
+   stack, both branches.  Prints only ABSENT destinations so the log carries
+   the population itself rather than a sample of the happy path.
+
+   branch k = the kernel-mode copy's destination, gs:[24]-320
+   branch u = the user-mode copy's destination,    target_sp-320
+
+   Card's question is "is every such site covered", so the site tag is the
+   point of this function: sch = schedule()'s resume boundary,
+   boot = start_scheduler()'s. */
+static void gb122_sample_resume(const char *site, struct process *p,
+                                uint64_t target_sp) {
+  extern int vm_arch_walk(struct addr_space *as, uint64_t va, uint64_t *l);
+  if (!p || !p->as)
+    return;
+  uint64_t cand[2];
+  const char *tag[2] = {"k", "u"};
+  cand[0] = arch_get_user_sp() - 320; /* kernel-branch copy destination */
+  cand[1] = target_sp - 320;          /* user-branch copy destination */
+  for (int i = 0; i < 2; i++) {
+    uint64_t page = cand[i] & ~0xFFFULL;
+    uint64_t leaf = 0;
+    if (page < USER_MAIN_STK_LIMIT_V2 || page >= USER_MAIN_STK_TOP_V2)
+      continue; /* outside the stack window: not this card's population */
+    if (vm_arch_walk(p->as, page, &leaf) == 0)
+      continue; /* present: nothing to report */
+    struct kline kl;
+    kl_init(&kl);
+    kl_s(&kl, "[GB122-S] site=");
+    kl_s(&kl, site);
+    kl_s(&kl, " br=");
+    kl_s(&kl, tag[i]);
+    kl_s(&kl, " pid=");
+    kl_i(&kl, p->pid);
+    kl_s(&kl, " parent=");
+    kl_i(&kl, p->parent_pid);
+    kl_s(&kl, " sp=");
+    kl_hex(&kl, target_sp);
+    kl_s(&kl, " gsp=");
+    kl_hex(&kl, cand[0] + 320);
+    kl_s(&kl, " page=");
+    kl_hex(&kl, page);
+    kl_s(&kl, "\n");
+    kl_emit(&kl);
+  }
+}
