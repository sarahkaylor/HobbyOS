+/* GB-122: refuse a kernel-mode resume whose 296-byte frame copy would land in
+ * an absent (or read-only) page, instead of faulting into it.
+ *
+ * The copy is `mov rax,gs:[24]; lea rdi,[rax-320]; rep movsq` -- 296 bytes
+ * ending exactly AT the stack top.  When that page has no leaf PTE the store
+ * takes #PF at CPL0 mid-copy (measured on unmodified main: `Vector: 14
+ * Error Code: 0x2`, RDI == dest == gs:[24]-0x140, RCX == 0x25), the process
+ * is killed and the frame is left half-written.
+ *
+ * Route (2) of the card, deliberately NOT GB-125's shape: the check is a
+ * few instructions of inline page-table read on the normal path -- no call,
+ * no stack frame, no allocation, no lock.  GB-125's guard called a C
+ * function whose 256-byte frame landed inside [gs:[24]-320, gs:[24]), the
+ * very window this copy writes, and GB-132 measured that build producing
+ * family-B banners that do not occur without it (6 banners in 2/2 guarded
+ * waves, 0 in 5 unguarded).  Nothing on this normal path may touch the
+ * stack for that reason.
+ *
+ * On refusal we take the same landing pad the #PF path already uses:
+ * process_fault_exit() -> process_exit() -> schedule(), which never returns
+ * and resumes another task.  A refusal must not halt the CPU: on T3_SMP=1
+ * that costs the whole wave, which is worse than the kill it replaces.
+ */
+void resume_nomap_refuse(struct trap_frame *tf) {
+  struct kline k;
+  uint64_t sp = arch_get_user_sp();
+  kl_init(&k);
+  kl_s(&k, "[RESUME-NOMAP] refusing to resume pid=");
+  kl_i(&k, current_process() ? (long)current_process()->pid : -1);
+  kl_s(&k, " target_sp=");
+  kl_hex(&k, sp);
+  kl_s(&k, " dest=");
+  kl_hex(&k, sp - 320);
+  kl_s(&k, " reason=absent-or-ro at resume\n");
+  kl_emit(&k);
+  process_fault_exit(tf, 11); /* SIGSEGV; schedule() inside never returns */
+}
+
