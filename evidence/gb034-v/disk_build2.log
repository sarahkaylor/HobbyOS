# GB-059: the S2 launcher scans /GAMES for titles (.BIN native ports and
# extension-less/.elf compat ELFs) — games_scan.c / desktop.c:915.  The
# directory must exist on the image or the scan is a documented no-op and
# no compat title can ever be launched by name.  Stage one of each kind
# here so "both a native port and a compat title through the one rig" is
# measurable from a shipped image rather than a hand-staged copy (which
# `make run` would wipe).
mmd -i disk.img ::/GAMES
mcopy -i disk.img obj/intel/xnibbler.bin ::/GAMES/XNIBBLER.BIN
mcopy -i disk.img obj/sdl_test_app_pie ::/GAMES/SDLTEST.ELF
