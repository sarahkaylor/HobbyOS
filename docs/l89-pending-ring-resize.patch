+/* L89 diagnostic: how many pool slots are in use (test-only reader). */
+int usock_pool_in_use(void) {
+  int n = 0;
+  uint64_t f = spinlock_acquire_irqsave(&unix_pool_lock);
+  for (int i = 0; i < MAX_UNIX_PAIRS; i++) if (unix_pool[i].in_use) n++;
+  spinlock_release_irqrestore(&unix_pool_lock, f);
+  return n;
+}
+
+/* L89: size one direction's ring.  The default (K_UNIX_RING) is what every
+ * socket has always had; a client that moves megabyte buffers per call -- an
+ * X server's PutImage of a full frame -- asks for a ring that holds the whole
+ * buffer, so the writer never fills it and never parks.  On this kernel a
+ * park costs a scheduler wake (~10 ms), so a 3.7 MB frame crossing a 512 KiB
+ * ring parks ~13 times; that is the whole of the "135 ms XPutImage".
+ *
+ * Grows only, never shrinks, and the copy of any queued bytes happens under
+ * u->lock (the same lock the reader holds while it copies out), so a resize
+ * can never race a transfer.  The new block is allocated BEFORE the lock:
+ * the frame allocator takes its own locks and must not nest inside this one. */
+int usock_set_ring(struct usock *u, int end, int bytes) {
+  if (!u || end < 0 || end > 1) return -EINVAL;
+  if (bytes <= 0) return -EINVAL;
+  if ((uint32_t)bytes < K_UNIX_RING) bytes = K_UNIX_RING;
+  if ((uint32_t)bytes > K_UNIX_RING_MAX) bytes = K_UNIX_RING_MAX;
+  uint32_t want = (uint32_t)((bytes + FRAME_SIZE - 1) & ~(FRAME_SIZE - 1));
+  uint64_t f = spinlock_acquire_irqsave(&u->lock);
+  int need = u->in_use && want > u->chan[end].cap;
+  spinlock_release_irqrestore(&u->lock, f);
+  if (!need) return 0;
+
+  uint8_t *nb = unix_ring_alloc_bytes(want);
+  if (!nb) return -ENOMEM;
+
+  f = spinlock_acquire_irqsave(&u->lock);
+  struct usock_chan *c = &u->chan[end];
+  if (!u->in_use || want <= c->cap) {  /* raced or already big enough */
+    spinlock_release_irqrestore(&u->lock, f);
+    unix_ring_free_bytes(nb, want);
+    return 0;
+  }
+  uint32_t n = c->used;
+  uint32_t first = c->cap - c->tail;
+  if (first > n) first = n;
+  for (uint32_t i = 0; i < first; i++) nb[i] = c->ring[c->tail + i];
+  for (uint32_t i = first; i < n; i++) nb[i] = c->ring[i - first];
+  uint8_t *old_own = c->own;
+  uint32_t old_cap = c->cap;
+  c->own = nb;
+  c->ring = nb;
+  c->cap = want;
+  c->tail = 0;
+  c->head = n % want;
+  spinlock_release_irqrestore(&u->lock, f);
+  unix_ring_free_bytes(old_own, old_cap);
+  return 0;
+}
+
+int usock_ring_cap(struct usock *u, int end) {
+  if (!u || end < 0 || end > 1) return 0;
+  uint64_t f = spinlock_acquire_irqsave(&u->lock);
+  int cap = (int)u->chan[end].cap;
+  spinlock_release_irqrestore(&u->lock, f);
+  return cap;
+}
