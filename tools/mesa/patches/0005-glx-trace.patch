Subject: [PATCH 5/5] glx/xlib: trace the client's GLX requests and our answers

The compat class has no apitrace and Unity's only report on a refused visual,
FBConfig or context is "Forced renderer 17 is not supported, exiting".  Every
GLX entry point that can refuse a renderer is therefore untestable from the
guest: you see the message, not the argument list that caused it.

This adds an opt-in trace (HOBBYOS_GLX_TRACE in the environment) that prints,
on stderr, the attribute lists glXChooseVisual / glXChooseFBConfig /
glXCreateContextAttribsARB actually receive, what glXGetFBConfigAttrib answers
for each attribute, and the config/context/drawable each call returns.  It is
compiled in unconditionally and costs one getenv on the first GLX call when
off; the shipped DSO's behaviour is unchanged.

Measured use (lane L27): the whole ladder from "Unity asks for a DirectColor
FBConfig" to "this frontend answers with a TrueColor visual" is one run.

--- a/src/gallium/frontends/glx/xlib/glx_api.c
+++ b/src/gallium/frontends/glx/xlib/glx_api.c
@@ -47,6 +47,62 @@
 #include "util/u_math.h"
 #include "util/u_memory.h"
 
+#include <stdlib.h>
+
+/* HOBBYOS (lane L27): GLX-level call trace.
+ *
+ * The guest has no apitrace and Unity's only report on a refused config or
+ * context is "Forced renderer 17 is not supported, exiting".  This prints the
+ * attribute lists Unity actually sends and exactly what this frontend answers,
+ * which is the only way to tell a missing visual from a rejected context.
+ * Compiled in always, active only when HOBBYOS_GLX_TRACE is in the environment
+ * (rwlaunch exports it from the /GLXON marker), so the shipped DSO costs one
+ * getenv on the first GLX call and nothing per call.
+ */
+static int
+hobbyos_glx_trace_on(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = getenv("HOBBYOS_GLX_TRACE") ? 1 : 0;
+   return on;
+}
+
+#define HGT(...) do {                                                    \
+   if (hobbyos_glx_trace_on()) {                                         \
+      fprintf(stderr, "[GLXT] " __VA_ARGS__);                            \
+      fflush(stderr);                                                    \
+   }                                                                     \
+} while (0)
+
+/* key/value attribute lists (glXChooseFBConfig, glXCreateContextAttribsARB) */
+static void
+hobbyos_glx_trace_kv(const char *what, const int *l, int max)
+{
+   int i;
+   if (!hobbyos_glx_trace_on())
+      return;
+   fprintf(stderr, "[GLXT] %s {", what);
+   for (i = 0; l && l[i] && i + 1 < max; i += 2)
+      fprintf(stderr, "%s0x%x=%d", i ? ", " : "", l[i], l[i + 1]);
+   fprintf(stderr, "}\n");
+   fflush(stderr);
+}
+
+/* single-token attribute lists (glXChooseVisual) */
+static void
+hobbyos_glx_trace_raw(const char *what, const int *l, int max)
+{
+   int i;
+   if (!hobbyos_glx_trace_on())
+      return;
+   fprintf(stderr, "[GLXT] %s [", what);
+   for (i = 0; l && i < max && l[i]; i++)
+      fprintf(stderr, "%s%d", i ? " " : "", l[i]);
+   fprintf(stderr, "]\n");
+   fflush(stderr);
+}
+
 /* An "Atrribs/Attribs" typo was fixed in glxproto.h in Nov 2014.
  * This is in case we don't have the updated header.
  */
