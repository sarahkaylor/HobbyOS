-   if (nouveau_ws_param(fd, NOUVEAU_GETPARAM_GRAPH_UNITS, &value))
+   int gu_ret = nouveau_ws_param(fd, NOUVEAU_GETPARAM_GRAPH_UNITS, &value);
+   if (gu_ret) {
+      /* Name the step: without this the driver just disappears. */
+      fprintf(stderr,
+              "nvk: GETPARAM(GRAPH_UNITS=%d) failed: %s (%d); no physical device\n",
