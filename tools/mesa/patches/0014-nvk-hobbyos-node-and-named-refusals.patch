tools/mesa: NVK reaches HobbyOS through a named node, and names every refusal (nvk)

Why: HobbyOS has no sysfs and no /dev/dri, so libdrm's drmGetDevices2() -- the
only device discovery nvk has -- finds nothing and the driver enumerates zero
physical devices with no explanation.  On top of that, Mesa's own error paths
report only "0 devices": a GETPARAM or NVIF refusal is invisible in the guest
log unless the userspace driver says which call and which class failed.

What, in three files:
  * nvk_instance.c    a device-enumeration hook that builds the one-element
                      drmDevice a named node describes ($NVK_HOBBYOS_NODE, else
                      /dev/nvshim) and runs it through the normal per-DRM path
                      (drm_fd_is_nouveau, VERSION, GETPARAM, VM_INIT, NVIF),
                      so everything below the hook is stock nvk.  No node ->
                      VK_ERROR_INCOMPATIBLE_DRIVER, i.e. the libdrm scan runs
                      unchanged on a real Linux host.
  * nouveau_device.c  GETPARAM(GRAPH_UNITS) failure names the parameter, errno
                      and the fact that no physical device follows.
  * nouveau_context.c NVIF object creation through a wrapper that names the
                      engine, the class id and errno when the kernel refuses.

Everything here is diagnostic or discovery: no rendering path is changed, and
the ABI the ICD speaks is upstream's.  Applied by tools/mesa/build-nvk.sh to
the pristine Mesa 25.0.7 tarball.

--- a/src/nouveau/vulkan/nvk_instance.c
+++ b/src/nouveau/vulkan/nvk_instance.c
@@ -20,6 +20,89 @@
 #include "vk_android.h"
 #endif
 
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <xf86drm.h>
+
+#include "drm-uapi/nouveau_drm.h"
+
+/* ---- HobbyOS: the DRM node is /dev/nvshim, discovered by name -----------
+ *
+ * HobbyOS has no sysfs and no /dev/dri, so libdrm's drmGetDevices2() -- the
+ * only device discovery this driver has -- finds nothing and nvk would
+ * enumerate zero physical devices with no explanation.  This hook builds the
+ * one-element drmDevice that a named node describes and runs it through the
+ * normal per-DRM path (drm_fd_is_nouveau(), VERSION, GETPARAM, VM_INIT, NVIF),
+ * so everything below this hook is stock nvk.
+ *
+ * The node is $NVK_HOBBYOS_NODE when set, else /dev/nvshim.  Absent node means
+ * "not HobbyOS": VK_ERROR_INCOMPATIBLE_DRIVER lets the libdrm scan run.
+ *
+ * The PCI device id is read back from the node with GETPARAM(PCI_DEVICE)
+ * rather than assumed; the vendor is NVIDIA by construction because this is
+ * the NVIDIA driver.  Any failure is reported on stderr and returned to the
+ * caller, never turned into a silent "0 devices".
+ */
+static VkResult
+nvk_hobbyos_enumerate(struct vk_instance *vk_inst)
+{
+   const char *env_path = getenv("NVK_HOBBYOS_NODE");
+   const char *path = (env_path != NULL && env_path[0] != '\0') ?
+                      env_path : "/dev/nvshim";
+
+   int fd = open(path, O_RDWR | O_CLOEXEC);
+   if (fd < 0) {
+      /* Only noisy when the node was named explicitly: otherwise this is a
+       * Linux host without /dev/nvshim and the libdrm scan should just run. */
+      if (env_path != NULL && env_path[0] != '\0') {
+         fprintf(stderr, "nvk: NVK_HOBBYOS_NODE=%s: open: %s\n", path,
+                 strerror(errno));
+      }
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+   }
+
+   struct drm_nouveau_getparam q = { .param = NOUVEAU_GETPARAM_PCI_DEVICE };
+   int ret = drmCommandWriteRead(fd, DRM_NOUVEAU_GETPARAM, &q, sizeof(q));
+   int saved = errno;
+   close(fd);
+   if (ret) {
+      fprintf(stderr, "nvk: %s: GETPARAM(PCI_DEVICE): %s\n", path,
+              strerror(saved));
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+   }
+
+   char *nodes[DRM_NODE_MAX] = { NULL };
+   drmPciBusInfo bus = { 0 };
+   drmPciDeviceInfo pci = {
+      .vendor_id = 0x10de, /* NVIDIA: the driver this ICD is */
+      .device_id = (uint16_t)q.value,
+   };
+   struct _drmDevice dev = {
+      .nodes = nodes,
+      .available_nodes = 1 << DRM_NODE_RENDER,
+      .bustype = DRM_BUS_PCI,
+      .businfo.pci = &bus,
+      .deviceinfo.pci = &pci,
+   };
+   nodes[DRM_NODE_RENDER] = (char *)path;
+
+   struct vk_physical_device *pdev = NULL;
+   VkResult result =
+      nvk_create_drm_physical_device(vk_inst, &dev, &pdev);
+   if (result != VK_SUCCESS) {
+      fprintf(stderr, "nvk: %s: physical device create failed: VkResult %d\n",
+              path, result);
+      return result;
+   }
+
+   list_addtail(&pdev->link, &vk_inst->physical_devices.list);
+   return VK_SUCCESS;
+}
+
+
 VKAPI_ATTR VkResult VKAPI_CALL
 nvk_EnumerateInstanceVersion(uint32_t *pApiVersion)
 {
@@ -167,6 +250,9 @@
    instance->vk.physical_devices.try_create_for_drm =
       nvk_create_drm_physical_device;
    instance->vk.physical_devices.destroy = nvk_physical_device_destroy;
+   /* HobbyOS: a named DRM node replaces libdrm's sysfs/`/dev/dri` scan.  The
+    * hook itself falls back to the libdrm path when /dev/nvshim is absent. */
+   instance->vk.physical_devices.enumerate = nvk_hobbyos_enumerate;
 
    const struct build_id_note *note =
       build_id_find_nhdr_for_addr(nvk_CreateInstance);
