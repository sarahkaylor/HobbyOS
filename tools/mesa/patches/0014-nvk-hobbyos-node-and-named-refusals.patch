    device->info.tpc_count = (value >> 8) & 0x0000ffff;
--- a/src/nouveau/winsys/nouveau_context.c
+++ b/src/nouveau/winsys/nouveau_context.c
@@ -6,6 +6,8 @@
 #include "nvif/ioctl.h"
 
 #include <errno.h>
+#include <stdio.h>
+#include <string.h>
 #include <xf86drm.h>
 
 static void
@@ -109,6 +111,24 @@
    return drmCommandWrite(fd, DRM_NOUVEAU_NVIF, &args, sizeof(args));
 }
 
+/* Same call, but a refusal is named on stderr.  Without this a driver that
+ * cannot get an engine object just disappears: nvk reports "0 devices" and
+ * the reason (which NVIF class, which errno) is only visible in the kernel's
+ * own console rows. */
+static int
+nouveau_ws_subchan_alloc_named(int fd, int channel, uint32_t handle,
+                               uint16_t oclass, struct nouveau_ws_object *obj,
+                               const char *engine)
+{
+   int ret = nouveau_ws_subchan_alloc(fd, channel, handle, oclass, obj);
+   if (ret != 0) {
+      fprintf(stderr,
+              "nvk: %s engine class object 0x%04x refused: %s (%d)\n",
+              engine, oclass, strerror(-ret), ret);
+   }
+   return ret;
+}
+
 static void
 nouveau_ws_channel_dealloc(int fd, int channel)
 {
@@ -145,24 +165,24 @@
 
    if (engines & NOUVEAU_WS_ENGINE_COPY) {
       uint32_t obj_class = nouveau_ws_context_find_class(classes, 0xb5);
-      ret = nouveau_ws_subchan_alloc(dev->fd, req.channel, 0,
-                                     obj_class, &(*out)->copy);
+      ret = nouveau_ws_subchan_alloc_named(dev->fd, req.channel, 0,
+                                           obj_class, &(*out)->copy, "copy");
       if (ret)
          goto fail_subchan;
    }
 
