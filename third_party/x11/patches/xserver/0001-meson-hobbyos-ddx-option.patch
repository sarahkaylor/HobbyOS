HobbyOS xserver patch (lane xserver, icewm.md M3).
meson: add -Dhobbyos (hw/hobbyos DDX, sources copied in by build-server.sh) 
and -Dhobbyos_link_args; on host system 'hobbyos': no BUSFAULT (no si_addr, 
SA_SIGINFO handlers never run) and no XTRANS_SEND_FDS (xtrans's 528-byte 
SCM_RIGHTS recvmsg buffer exceeds the kernel's 512-byte K_IPC_CTRL_MAX -> 
EINVAL; nothing here passes fds).

diff --git a/hw/meson.build b/hw/meson.build
index f8bd28a..9491048 100644
--- a/hw/meson.build
+++ b/hw/meson.build
@@ -2,6 +2,10 @@ if get_option('xephyr')
     subdir('kdrive')
 endif
 
+if get_option('hobbyos')
+    subdir('hobbyos')
+endif
+
 if get_option('xvfb')
     subdir('vfb')
 endif
diff --git a/include/meson.build b/include/meson.build
index bda84bd..5566a08 100644
--- a/include/meson.build
+++ b/include/meson.build
@@ -181,7 +181,13 @@ conf_data.set('HAVE_VASPRINTF', cc.has_function('vasprintf') ? '1' : false)
 conf_data.set('HAVE_VSNPRINTF', cc.has_function('vsnprintf') ? '1' : false)
 conf_data.set('HAVE_WALKCONTEXT', cc.has_function('walkcontext') ? '1' : false)
 
-conf_data.set('BUSFAULT', conf_data.get('HAVE_SIGACTION'))
+# HobbyOS: siginfo_t carries no si_addr and SA_SIGINFO handlers are never
+# invoked, so the SIGBUS shm-fault tracker (os/busfault.c) cannot work.
+if host_machine.system() == 'hobbyos'
+    conf_data.set('BUSFAULT', false)
+else
+    conf_data.set('BUSFAULT', conf_data.get('HAVE_SIGACTION'))
+endif
 
 # Don't let X dependencies typedef 'pointer'
 conf_data.set('_XTYPEDEF_POINTER', '1')
@@ -191,7 +197,10 @@ conf_data.set('LISTEN_TCP', get_option('listen_tcp'))
 conf_data.set('LISTEN_UNIX', get_option('listen_unix'))
 conf_data.set('LISTEN_LOCAL', get_option('listen_local'))
 
-if cc.has_header_symbol('sys/socket.h', 'SCM_RIGHTS')
+# HobbyOS: no fd-passing extension is built (no DRI3/MIT-SHM), and xtrans
+# reads with a 528-byte SCM_RIGHTS control buffer that the kernel's
+# recvmsg() rejects (> K_IPC_CTRL_MAX 512 -> EINVAL); plain read() instead.
+if cc.has_header_symbol('sys/socket.h', 'SCM_RIGHTS') and host_machine.system() != 'hobbyos'
   conf_data.set('XTRANS_SEND_FDS', '1')
 endif
 
