 IceSh* IceSh::singleton;
 
+void IceSh::bail(int code) {
+    int status = code;
+    if (singleton) {
+        singleton->rc = code;
+        status = int(*singleton);
+        singleton->~IceSh();
+        singleton = nullptr;
+    }
+    fflush(stdout);
+    fflush(stderr);
+    exit(status);
