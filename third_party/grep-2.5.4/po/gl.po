#: src/grep.c:1424
#, fuzzy, c-format
msgid ""
"Example: %s -i 'hello world' menu.h main.c\n"
"\n"
"Regexp selection and interpretation:\n"
msgstr ""
"Busca o PATRÓN en cada FICHEIRO ou na entrada estándar.\n"
