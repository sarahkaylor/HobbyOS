# -- user object rules -------------------------------------------------
$(OBJDIR)/arm/hello.o: src/user/hello.c
	$(CC) $(USER_CFLAGS) -c $< -o $@
	@echo "[SELFHOST] phase=user-compile rc=$$?"

$(OBJDIR)/arm/sh.o: src/user/sh.c
	$(CC) $(USER_CFLAGS) -c $< -o $@
	@echo "[SELFHOST] phase=user-compile rc=$$?"

$(OBJDIR)/arm/sh_aux.o: src/user/sh_aux.c
	$(CC) $(USER_CFLAGS) -c $< -o $@
	@echo "[SELFHOST] phase=user-compile rc=$$?"

$(OBJDIR)/arm/ls.o: src/user/ls.c
	$(CC) $(USER_CFLAGS) -c $< -o $@
	@echo "[SELFHOST] phase=user-compile rc=$$?"

$(OBJDIR)/arm/cat.o: src/user/cat.c
	$(CC) $(USER_CFLAGS) -c $< -o $@
	@echo "[SELFHOST] phase=user-compile rc=$$?"

# -- frozen targets ----------------------------------------------------
# S0 — one-TU compile smoke (acceptance.md §1): compile the L4 sketch's
# designated TU (src/kernel/main.c) with the kernel flags, no link.
check:
	@echo "[SELFHOST] phase=s0-check-start"
	$(CC) $(KERNEL_CFLAGS) -c src/kernel/main.c -o $(OBJDIR)/arm/check.o
	@echo "[SELFHOST] phase=s0-check-done rc=$$?"

# S1 — the acceptance user set (AD-9 HELLO SH LS CAT), compiled + linked
# against the carried libc archive (host shape: crt0.o is inside libc.a).
user: $(USER_OBJS) $(OBJDIR)/arm/libc.a
	@echo "[SELFHOST] phase=s1-user-start"
	$(LD) -T src/user/linker.ld -o $(OBJDIR)/arm/sh.elf $(OBJDIR)/arm/sh.o $(OBJDIR)/arm/sh_aux.o $(OBJDIR)/arm/libc.a
	$(OBJCOPY) -O binary $(OBJDIR)/arm/sh.elf $(OBJDIR)/arm/SH.BIN
	$(LD) -T src/user/linker.ld -o $(OBJDIR)/arm/ls.elf $(OBJDIR)/arm/ls.o $(OBJDIR)/arm/libc.a
	$(OBJCOPY) -O binary $(OBJDIR)/arm/ls.elf $(OBJDIR)/arm/LS.BIN
	$(LD) -T src/user/linker.ld -o $(OBJDIR)/arm/cat.elf $(OBJDIR)/arm/cat.o $(OBJDIR)/arm/libc.a
	$(OBJCOPY) -O binary $(OBJDIR)/arm/cat.elf $(OBJDIR)/arm/CAT.BIN
	$(LD) -T src/user/linker.ld -o $(OBJDIR)/arm/hello.elf $(OBJDIR)/arm/hello.o $(OBJDIR)/arm/libc.a
	$(OBJCOPY) -O binary $(OBJDIR)/arm/hello.elf $(OBJDIR)/arm/HELLO.BIN
	@echo "[SELFHOST] phase=s1-user-done rc=$$?"

# S2 — the kernel, in-OS: all 59 TUs, then the lld link + objcopy.
kernel: $(KERNEL_OBJS)
	@echo "[SELFHOST] phase=s2-kernel-start"
	@echo "[SELFHOST] phase=kernel-link-start"
	$(LD) -T linker.ld -o $(TARGET) $(KERNEL_OBJS)
	@echo "[SELFHOST] phase=kernel-link-done rc=$$?"
	$(OBJCOPY) -O binary $(TARGET) $(BIN)
	@echo "[SELFHOST] phase=s2-kernel-done rc=$$?"

# S3 — assemble OUT.IMG in-OS (acceptance.md §8.1 layout: the layout that
# actually boots under AAVMF/Limine).  User bins come from the S1 build;
# DESKTOP/CONSOLE/SH and the OUTMARK marker are carried host-built products
# staged under /SRC/bin (the desktop-path requirement, acceptance §8.3).
disk: kernel user
	@echo "[SELFHOST] phase=s3-disk-start"
	$(RM) -f $(OUTIMG)
	$(MKFSFAT) -F 16 -C $(OUTIMG) $(DISK_BLOCKS)
	$(MMD) -i $(OUTIMG) ::/boot
	$(MMD) -i $(OUTIMG) ::/EFI
	$(MMD) -i $(OUTIMG) ::/EFI/BOOT
	$(MCOPY) -i $(OUTIMG) $(BIN) ::/boot/hobbyos.bin
	$(MCOPY) -i $(OUTIMG) limine.conf ::/boot/limine.conf
	$(MCOPY) -i $(OUTIMG) bootloader/BOOTAA64.EFI ::/EFI/BOOT/BOOTAA64.EFI
	$(MCOPY) -i $(OUTIMG) $(OBJDIR)/arm/HELLO.BIN ::/HELLO.BIN
	$(MCOPY) -i $(OUTIMG) $(OBJDIR)/arm/SH.BIN ::/SH.BIN
	$(MCOPY) -i $(OUTIMG) $(OBJDIR)/arm/LS.BIN ::/LS.BIN
	$(MCOPY) -i $(OUTIMG) $(OBJDIR)/arm/CAT.BIN ::/CAT.BIN
	$(MCOPY) -i $(OUTIMG) bin/DESKTOP.BIN ::/DESKTOP.BIN
	$(MCOPY) -i $(OUTIMG) bin/CONSOLE.BIN ::/CONSOLE.BIN
	$(MCOPY) -i $(OUTIMG) bin/SH.BIN ::/bin/SH.BIN
	$(MCOPY) -i $(OUTIMG) $(OBJDIR)/arm/HELLO.BIN ::/OUTPROG.BIN
	$(MCOPY) -i $(OUTIMG) bin/OUTMARK.TXT ::/OUTMARK.TXT
	@echo "[SELFHOST] phase=s3-disk-done rc=$$?"

all: check user kernel disk
	@echo "[SELFHOST] phase=all-done rc=$$?"
